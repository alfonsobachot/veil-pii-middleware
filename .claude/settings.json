{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "model": "sonnet",
  "includeCoAuthoredBy": true,
  "cleanupPeriodDays": 30,

  "env": {
    "DISABLE_TELEMETRY": "0",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1"
  },

  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",

    "allow": [
      "Read(./**)",
      "Edit(./src/**)",
      "Edit(./tests/**)",
      "Edit(./docs/**)",
      "Write(./src/**)",
      "Write(./tests/**)",

      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(git stash:*)",

      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",

      "Bash(npm run lint)",
      "Bash(npm run test:*)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(pnpm lint)",
      "Bash(pnpm test:*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm build)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(.harness/bin/verify)",
      "Bash(.harness/bin/verify:*)",
      "Bash(./.harness/bin/verify)",
      "Bash(./.harness/bin/verify:*)",
      "Bash(.harness/internal/check-mission-contract)",
      "Bash(.harness/internal/check-mission-contract:*)",
      "Bash(.harness/bin/memory:*)",
      "Bash(.harness/bin/skill:*)"
    ],

    "ask": [
      "Bash(git push:*)",
      "Bash(npm install:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm install:*)",
      "Bash(pip install:*)",
      "Bash(uv add:*)",
      "Bash(docker:*)",
      "WebFetch"
    ],

    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./secrets/**)",
      "Read(./**/credentials*)",
      "Read(./**/id_rsa*)",
      "Edit(./.env*)",
      "Edit(./**/*.lock)",
      "Edit(./pnpm-lock.yaml)",
      "Edit(./package-lock.json)",
      "Edit(./poetry.lock)",
      "Edit(./.gitlab-ci.yml)",
      "Edit(./.github/workflows/**)",
      "Edit(./.circleci/**)",
      "Edit(./Jenkinsfile)",
      "Edit(./azure-pipelines.yml)",
      "Write(./.gitlab-ci.yml)",
      "Write(./.github/workflows/**)",
      "Write(./.circleci/**)",
      "Write(./Jenkinsfile)",
      "Write(./azure-pipelines.yml)",
      "Write(./.env*)",
      "Bash(glab mr merge:*)",
      "Bash(glab mr approve:*)",
      "Bash(gh pr merge:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(sudo:*)"
    ],

    "additionalDirectories": []
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/protect-paths.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/mission-state-guard.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/grill-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/protect-paths.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/verify-gate.sh"
          }
        ]
      }
    ]
  }
}
