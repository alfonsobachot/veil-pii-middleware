{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "//": "Copy this file to settings.local.json (gitignored) for PERSONAL overrides.",
  "//2": "Nothing here is shared with the team. Use it for your machine, your model preference, your extra MCP servers, etc.",

  "model": "opus",

  "permissions": {
    "//": "Add directories outside the repo you want Claude to read on your machine.",
    "additionalDirectories": [
      "../shared-design-system/"
    ],
    "//2": "Loosen or tighten for your own workflow only.",
    "allow": [
      "Bash(gh:*)"
    ]
  },

  "//3": "Personal MCP servers (e.g. a local DB you run) go in settings.local.json or via `claude mcp add --scope local`.",
  "enableAllProjectMcpServers": false
}
