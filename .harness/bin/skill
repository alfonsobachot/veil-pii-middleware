#!/usr/bin/env bash
#
# harness-skill.sh — create and improve repo-native agent skills.
#
# Skills are generated as active files under .harness/skills/<name>/ and mirrored
# into native Claude/OpenCode skill folders. OpenCode slash-command wrappers are
# generated separately as convenience entrypoints, not as skill definitions.

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
SKILL_ROOT="$ROOT/.harness/skills"
CLAUDE_SKILLS="$ROOT/.claude/skills"
OPENCODE_SKILLS="$ROOT/.opencode/skills"
OPENCODE_COMMANDS="$ROOT/.opencode/commands"

usage() {
  cat <<'EOF'
Usage:
  .harness/bin/skill create --name <slug> --trigger <text> --summary <text> [options]
  .harness/bin/skill improve --name <slug> --evidence <text> --change <text>
  .harness/bin/skill list

Create options:
  --evidence <text>  Source evidence, usually memory event or handoff path.
  --tags <csv>       Comma-separated tags.

Rules:
  - Generated skills are active repo-native skills.
  - Default structure follows the write-a-skill skill.
  - Description must be trigger-rich and include "Use when".
  - Skills mirror to .claude/skills/<name>/SKILL.md and .opencode/skills/<name>/SKILL.md.
  - Do not create skills from one weak signal; cite evidence.
  - Do not encode secrets, credentials, or private user memory.
  - Do not mutate verification gates automatically.
EOF
}

slug_ok() {
  [ "${#1}" -ge 1 ] && [ "${#1}" -le 64 ] && [[ "$1" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]
}

description_ok() {
  [ "${#1}" -le 1024 ] && [[ "$1" == *"Use when"* ]]
}

ensure_roots() {
  mkdir -p "$SKILL_ROOT"
  [ ! -d "$ROOT/.claude" ] || mkdir -p "$CLAUDE_SKILLS"
  [ ! -d "$ROOT/.opencode" ] || mkdir -p "$OPENCODE_SKILLS" "$OPENCODE_COMMANDS"
}

record_memory() {
  local type="$1" summary="$2" source="$3" tags="$4" prevention="$5"
  "$ROOT/.harness/bin/memory" record \
    --type "$type" \
    --summary "$summary" \
    --source "$source" \
    --tags "$tags" \
    --prevention "$prevention" >/dev/null
}

cmd="${1:-}"
[ -n "$cmd" ] || { usage; exit 1; }
shift || true

case "$cmd" in
  create)
    name=""
    trigger=""
    summary=""
    evidence=""
    tags=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --name) name="${2:-}"; shift 2 ;;
        --trigger) trigger="${2:-}"; shift 2 ;;
        --summary) summary="${2:-}"; shift 2 ;;
        --evidence) evidence="${2:-}"; shift 2 ;;
        --tags) tags="${2:-}"; shift 2 ;;
        --help|-h) usage; exit 0 ;;
        *) echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
      esac
    done
    [ -n "$name" ] || { echo "--name is required" >&2; exit 1; }
    [ -n "$trigger" ] || { echo "--trigger is required" >&2; exit 1; }
    [ -n "$summary" ] || { echo "--summary is required" >&2; exit 1; }
    slug_ok "$name" || { echo "--name must be 1-64 chars and match ^[a-z0-9]+(-[a-z0-9]+)*$" >&2; exit 1; }
    description_ok "$trigger" || { echo "--trigger must be <=1024 chars and include 'Use when'." >&2; exit 1; }
    ensure_roots
    skill_dir="$SKILL_ROOT/$name"
    [ ! -e "$skill_dir" ] || { echo "Skill already exists: $name" >&2; exit 1; }
    mkdir -p "$skill_dir"
    cat > "$skill_dir/SKILL.md" <<EOF
---
name: $name
description: $trigger
status: active
source_evidence: ${evidence:-unspecified}
---

# $name

$summary

## Quick Start

1. Confirm the task matches this trigger:
   $trigger
2. Read only the harness context needed for the current task.
3. Run the workflow below.
4. Record memory or skill improvements when evidence shows the skill should evolve.

## Workflow

1. Read the current harness files: \`AGENTS.md\`, \`CLAUDE.md\`, \`.harness/mission.md\`, \`.harness/validation.md\`, and \`.harness/handoff.md\`.
2. Inspect the repository for discoverable facts before asking questions.
3. Apply the narrow procedure described by this skill.
4. Run or cite the relevant verification evidence.
5. Record gotchas or improvements with \`.harness/bin/memory\`.

## Evidence

- ${evidence:-Add evidence for the next self-improvement pass.}

## Safety

- Do not record secrets, credentials, or private user memory.
- Do not mutate gates, tests, external systems, Jira, or Confluence without human approval.
- Keep this skill narrow; split it if it grows beyond one repeatable procedure.

## Self-Check

- [ ] Description includes specific \`Use when\` triggers.
- [ ] Procedure is concise and repeatable.
- [ ] References, if any, are one level deep.
- [ ] Scripts, if any, are deterministic and necessary.
- [ ] Evidence is named.
EOF
    if [ -d "$ROOT/.claude" ]; then
      mkdir -p "$CLAUDE_SKILLS/$name"
      cp "$skill_dir/SKILL.md" "$CLAUDE_SKILLS/$name/SKILL.md"
      rm -f "$CLAUDE_SKILLS/$name.md"
    fi
    if [ -d "$ROOT/.opencode" ]; then
      mkdir -p "$OPENCODE_SKILLS/$name"
      cp "$skill_dir/SKILL.md" "$OPENCODE_SKILLS/$name/SKILL.md"
      rm -f "$OPENCODE_SKILLS/$name.md"
      cat > "$OPENCODE_COMMANDS/$name.md" <<EOF
---
description: $trigger
agent: orchestrator
subtask: true
---

Use the repo-native skill \`$name\` for: \$ARGUMENTS.

Canonical skill:
@.harness/skills/$name/SKILL.md

Native OpenCode skill:
@.opencode/skills/$name/SKILL.md

Claude-compatible skill:
@.claude/skills/$name/SKILL.md

Canonical harness context:
@AGENTS.md
@CLAUDE.md
@.harness/mission.md
@.harness/validation.md
@.harness/handoff.md

Follow the skill procedure exactly. This skill is active when present in the repo.
Cite evidence, record improvements, and require human approval before mutating
external systems.
EOF
    fi
    record_memory "skill-created" "Created active skill $name" ".harness/skills/$name/SKILL.md" "$tags" "Review skill evidence and rollback through git if it causes bad behavior."
    echo "Created active skill: $name"
    ;;

  improve)
    name=""
    evidence=""
    change=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --name) name="${2:-}"; shift 2 ;;
        --evidence) evidence="${2:-}"; shift 2 ;;
        --change) change="${2:-}"; shift 2 ;;
        --help|-h) usage; exit 0 ;;
        *) echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
      esac
    done
    [ -n "$name" ] || { echo "--name is required" >&2; exit 1; }
    [ -n "$evidence" ] || { echo "--evidence is required" >&2; exit 1; }
    [ -n "$change" ] || { echo "--change is required" >&2; exit 1; }
    skill_file="$SKILL_ROOT/$name/SKILL.md"
    [ -f "$skill_file" ] || { echo "Unknown skill: $name" >&2; exit 1; }
    {
      echo
      echo "## Improvement Log"
      echo
      echo "- Evidence: $evidence"
      echo "  Change: $change"
    } >> "$skill_file"
    if [ -d "$ROOT/.claude" ]; then
      mkdir -p "$CLAUDE_SKILLS/$name"
      cp "$skill_file" "$CLAUDE_SKILLS/$name/SKILL.md"
      rm -f "$CLAUDE_SKILLS/$name.md"
    fi
    if [ -d "$ROOT/.opencode" ]; then
      mkdir -p "$OPENCODE_SKILLS/$name"
      cp "$skill_file" "$OPENCODE_SKILLS/$name/SKILL.md"
      rm -f "$OPENCODE_SKILLS/$name.md"
    fi
    record_memory "skill-improved" "Improved active skill $name" "$skill_file" "$name" "$change"
    echo "Improved active skill: $name"
    ;;

  list)
    if [ ! -d "$SKILL_ROOT" ]; then
      echo "No repo-native skills yet."
      exit 0
    fi
    find "$SKILL_ROOT" -mindepth 2 -maxdepth 2 -name SKILL.md | sed "s#^$SKILL_ROOT/##; s#/SKILL.md\$##" | sort
    ;;

  --help|-h|help)
    usage
    ;;

  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
