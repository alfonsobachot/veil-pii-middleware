#!/usr/bin/env bash
#
# .harness/bin/verify — THE VERIFICATION CONTRACT for this repository.
#
# One command, one exit code, one structured report. Everything that needs to
# answer "is this task done?" calls this and nothing else:
#   - the developer, by hand
#   - the autonomous Stop hook (.claude/hooks/verify-gate.sh)
#   - Claude/OpenCode orchestration commands
#   - CI or evaluation jobs when a project wires them in
#
# Because every consumer shares this one interface, the system stays simple and
# expandable: to add a check, add a line to GATES. To support a new language,
# fill GATES with that language's commands. Nothing downstream changes.
#
# Usage:
#   .harness/bin/verify            human-readable report
#   .harness/bin/verify --json     machine-readable summary on stdout
# Exit: 0 if every configured gate passes, 1 otherwise, 2 if nothing configured.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
case "$SCRIPT_DIR" in
  */.harness/bin) ROOT="$(cd "$SCRIPT_DIR/../.." && pwd -P)" ;;
  *) ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)" ;;
esac
cd "$ROOT"

# ============================================================================
# CONFIGURE: one "name|command" per gate. Order matters (cheap/fast first).
# Fill these from the commands in CLAUDE.md. Leave a command empty or as a
# <PLACEHOLDER> to skip it. Add or remove lines freely.
# ============================================================================
# Tools live in the project virtualenv, not on PATH. Resolve the bin directory
# once so the same gate rows work on Windows (Scripts) and POSIX (bin).
VENV_BIN=".venv/Scripts"
[ -d "$VENV_BIN" ] || VENV_BIN=".venv/bin"

GATES=(
  "contract|.harness/internal/check-mission-contract"
  "lint|$VENV_BIN/ruff check . && $VENV_BIN/ruff format --check ."
  "typecheck|$VENV_BIN/mypy"
  "test|$VENV_BIN/pytest"
  "build|$VENV_BIN/python -m build --no-isolation"
)

# The `contract` row checks the mission's routing paperwork
# (agent-practices contract via .harness/adapter.yaml), not the project.
# It ships to targets, skips while the mission is `not started`, and never
# counts toward "configured" — a repo with no project gates still reports
# unconfigured (exit 2).

# Task-specific acceptance checks: any executable file under this directory is
# run as an additional gate. The process pack (/spec) writes these so each
# acceptance criterion has an objective, executable check. Keep them fast.
ACCEPTANCE_DIR=".harness/acceptance"

# ----------------------------------------------------------------------------
JSON=0
[ "${1:-}" = "--json" ] && JSON=1

names=(); commands=(); results=(); exit_codes=(); durations=(); tails=()
configured=0; failed=0; project_configured=0

json_escape() {
  # python3 path covers the full RFC 8259 control-character range
  # (U+0000–U+001F); the awk fallback keeps older boxes working but only
  # escapes the common cases.
  python3 -c "import sys,json; print(json.dumps(sys.stdin.read())[1:-1])" \
    2>/dev/null || \
  awk 'BEGIN { ORS="" }
    {
      gsub(/\\/, "\\\\")
      gsub(/"/, "\\\"")
      gsub(/\t/, "\\t")
      gsub(/\r/, "\\r")
      gsub(/\033/, "\\u001b")
      if (NR > 1) printf "\\n"
      printf "%s", $0
    }'
}

run_gate() {
  local name="$1" cmd="$2"
  # skip empty or unfilled placeholder commands
  if [ -z "$cmd" ] || [[ "$cmd" == \<*\> ]]; then
    return 0
  fi
  configured=$((configured + 1))
  case "$name" in
    contract|enforcement) ;;
    *) project_configured=$((project_configured + 1)) ;;
  esac
  local out rc start end duration tail_out
  start="$(date +%s)"
  out="$(bash -c "$cmd" 2>&1)"; rc=$?
  end="$(date +%s)"
  duration=$(( (end - start) * 1000 ))
  tail_out="$(printf '%s\n' "$out" | tail -n 12)"
  names+=("$name")
  commands+=("$cmd")
  exit_codes+=("$rc")
  durations+=("$duration")
  tails+=("$tail_out")
  if [ $rc -eq 0 ]; then
    results+=("pass")
    [ $JSON -eq 0 ] && printf '  \033[32m✓\033[0m %-12s %s\n' "$name" "$cmd"
  else
    results+=("fail")
    failed=$((failed + 1))
    if [ $JSON -eq 0 ]; then
      printf '  \033[31m✗\033[0m %-12s %s\n' "$name" "$cmd"
      printf '%s\n' "$out" | sed 's/^/      /' | tail -n 12
    fi
  fi
}

[ $JSON -eq 0 ] && echo "verify · $(basename "$(pwd)")"

for entry in "${GATES[@]}"; do
  run_gate "${entry%%|*}" "${entry#*|}"
done

# acceptance checks
if [ -d "$ACCEPTANCE_DIR" ]; then
  for f in "$ACCEPTANCE_DIR"/*; do
    if [ -f "$f" ] && [ -x "$f" ]; then
      run_gate "accept:$(basename "$f")" "$f"
    elif [ -f "$f" ]; then
      # visible skip instead of silent false-green (eval EV-02)
      printf '  \033[33m⚠\033[0m accept:%-10s SKIPPED — not executable (run: chmod +x %s)\n' \
             "$(basename "$f")" "$f" >&2
    fi
  done
fi

# ----------------------------------------------------------------------------
# Report
if [ $JSON -eq 1 ]; then
  printf '{"configured":%d,"project_configured":%d,"failed":%d,"gates":[' "$configured" "$project_configured" "$failed"
  for i in "${!names[@]}"; do
    [ "$i" -gt 0 ] && printf ','
    printf '{"name":"%s","command":"%s","result":"%s","exit_code":%d,"duration_ms":%d,"output_tail":"%s"}' \
      "$(printf '%s' "${names[$i]}" | json_escape)" \
      "$(printf '%s' "${commands[$i]}" | json_escape)" \
      "$(printf '%s' "${results[$i]}" | json_escape)" \
      "${exit_codes[$i]}" \
      "${durations[$i]}" \
      "$(printf '%s' "${tails[$i]}" | json_escape)"
  done
  printf ']}\n'
fi

if [ "$failed" -gt 0 ]; then
  [ $JSON -eq 0 ] && echo "RESULT: NOT DONE — $failed of $configured gate(s) failed."
  exit 1
fi

if [ "$project_configured" -eq 0 ]; then
  [ $JSON -eq 0 ] && echo "NOT CONFIGURED — no project gates defined. Verification cannot pass until GATES is filled." >&2
  exit 2
fi

[ $JSON -eq 0 ] && echo "RESULT: PASS — all $configured gate(s) green."
exit 0
